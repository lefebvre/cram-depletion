#pragma once
//
// Generated by CMake from cram/version.hpp.in into the build tree; the copy you
// are reading in a build or install directory is not the file to edit.
//
// The single source of truth for cram's version is the project() call in the
// top-level CMakeLists.txt. Everything else derives from it: this header, the
// cramConfigVersion.cmake that answers find_package(cram <version>), and the
// `deplete --version` output. The release tag is checked against it in CI, so
// a tag that disagrees with project() fails the build rather than shipping.
//
// Note that these describe the version cram was *built* from. A consumer that
// wants the version it *compiled against* is reading the same thing; there is
// no separate runtime query, because the library is static.

#define CRAM_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define CRAM_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define CRAM_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define CRAM_VERSION_STRING "@PROJECT_VERSION@"

// Single integer for ordered comparisons, e.g.
//   #if CRAM_VERSION_HEX >= 0x010001
// Two hex digits per component, so it stays monotonic until a component
// reaches 256.
#define CRAM_VERSION_HEX                                                    \
  ((CRAM_VERSION_MAJOR << 16) | (CRAM_VERSION_MINOR << 8) | CRAM_VERSION_PATCH)

namespace cram {

// "MAJOR.MINOR.PATCH" -- the same string CMake's project() was given.
inline constexpr const char* kVersion = CRAM_VERSION_STRING;

}  // namespace cram
