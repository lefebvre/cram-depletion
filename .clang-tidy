# clang-tidy configuration for cram-depletion.
# Pragmatic check set: bug-prone patterns, core guidelines, performance,
# readability — without the noisiest opinionated checks for a numerics codebase.
Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-*,
  performance-*,
  readability-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -performance-enum-size,
  -readability-magic-numbers,
  -readability-braces-around-statements,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-identifier-length,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-constant-array-index

# The bug-class families fail the static-analysis job; the style families stay
# advisory, since their findings are judgments rather than defects and gating
# on them would make every new check in a clang-tidy release a CI failure.
WarningsAsErrors: 'bugprone-*,performance-*'
HeaderFilterRegex: 'cram/.*'
FormatStyle: none
